{
  "name": "crown-and-frontier",
  "version": "0.3.0",
  "private": true,
  "description": "Crown & Frontier: a single-player browser grand strategy game about integrating a frontier realm.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "genmap": "tsx tools/genmap.ts",
    "sim": "tsx tools/sim-cli.ts",
    "package": "tsx tools/package-zip.ts",
    "verify:web": "tsx tools/verify-web.ts",
    "examples": "tsx tools/combat-examples.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run package && npm run verify:web",
    "genworld": "tsx tools/genworld.ts",
    "genseas": "tsx tools/genseas.ts",
    "genstress": "tsx tools/genstress.ts",
    "bench": "node --expose-gc --import tsx tools/bench.ts",
    "bench:web": "tsx tools/bench-web.ts",
    "rulecheck": "tsx tools/rulecheck.ts",
    "fuzz": "tsx tools/fuzz.ts",
    "genmaps": "tsx tools/genmaps.ts",
    "genbaltic": "tsx tools/genbaltic.ts"
  },
  "devDependencies": {
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^22.20.4",
    "playwright": "1.56.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@fontsource-variable/alegreya": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource/alegreya-sc": "^5.3.0",
    "d3-delaunay": "^6.0.4"
  }
}
